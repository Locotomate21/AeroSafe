# AeroSafe - Plantilla de configuracion
#
#   cp .env.example .env    y rellenar los valores reales.
#
# .env NUNCA se versiona: contiene credenciales. Si alguna vez se
# commitea por error, rotar TODAS las claves antes que nada; borrarlas
# del historial de git no sirve, quedan en cualquier clon existente.

# ============================================================
# Servidor
# ============================================================
HOST=0.0.0.0
PORT=8000

# DEBUG=true expone la traza interna en los errores 500 y activa el
# recargado automatico. Solo para desarrollo local.
DEBUG=false

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================================
# Base de datos
# ============================================================
# SQLite para desarrollo. En produccion:
#   postgresql://usuario:password@host:5432/aerosafe
DATABASE_URL=sqlite:///./aerosafe.db

# ============================================================
# APIs externas
# ============================================================
# https://openweathermap.org/api  (plan gratuito suficiente)
OPENWEATHER_API_KEY=
WEATHER_API_KEY=

# ============================================================
# Seguridad
# ============================================================
# Origenes permitidos para CORS, separados por comas.
# No usar '*': la API envia credenciales.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Autenticacion por cabecera X-API-Key.
# En produccion: REQUIRE_API_KEY=true y claves generadas al azar
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REQUIRE_API_KEY=false
VALID_API_KEYS=

# Peticiones por minuto y por IP.
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=100

# ============================================================
# Modelo ML (rutas relativas a backend/)
# ============================================================
MODEL_PATH=models/production/model.pkl
SCALER_PATH=models/production/scaler.pkl
ENCODER_PATH=models/production/label_encoder.pkl
FEATURE_NAMES_PATH=models/production/feature_names.txt

# ============================================================
# MLflow / DagsHub  (solo para entrenar, no para servir)
# ============================================================
# Sin estas variables, MLflow registra en local (sqlite:///mlflow.db).
DAGSHUB_USERNAME=
DAGSHUB_REPO=AeroSafe
DAGSHUB_TOKEN=
MLFLOW_EXPERIMENT_NAME=aerosafe-production

# ============================================================
# Procesamiento batch
# ============================================================
BATCH_INPUT_DIR=data/batch/input
BATCH_OUTPUT_DIR=data/batch/output
BATCH_ERROR_DIR=data/batch/errors
BATCH_ARCHIVE_DIR=data/batch/archive
